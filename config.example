# nex config — copy to ~/.config/nex/config
# Ghostty-style `key = value`. Saved changes apply right away (Ctrl+Shift+, reloads by hand;
# Cmd+Shift+, on macOS).

# Default (unset): the first installed "… Nerd Font Mono" family, otherwise the built-in
# JetBrainsMono Nerd Font Mono. Nerd Font icons always work as a fallback.
# font-family = JetBrainsMono Nerd Font Mono
font-size = 14
adjust-cell-height = 12%

background = #1f1b1e
foreground = #d9d4dd
cursor-color = #e8e3ec
selection-background = #4a4048
# selection-foreground = #ffffff

# palette = 0=#2b2830
# palette = 1=#f2777a
# ... entries 0-15
# Dot on a tab whose program rang the bell or wants input (e.g. Claude Code).
# Default (unset): palette 3, yellow.
# tab-attention-color = #ffcc66

background-opacity = 0.90
unfocused-split-opacity = 0.90
window-padding = 10
# Defaults depend on the OS: Linux draws nex's own title bar and buttons (decorations off,
# controls on); macOS uses the native traffic lights (decorations on, controls off).
# window-decorations = false
# window-controls = true    # close / minimize / maximize buttons in the title bar
pane-headers = true
animations = true           # pane splits / closes, focus fades, title-bar tabs
tab-animation = glide       # switching tabs: glide | ink | none
explorer-view = list        # file explorer layout: list | grid
mobile = false              # phone-sized touch screens: tabs in a left sidebar, bigger buttons

cursor-style = block        # block | bar | underline
cursor-style-blink = true
copy-on-select = false
clipboard-toasts = true     # "Copied …" / "Pasted …" toasts for terminal copy and paste
# Files dropped (or an image or files pasted) into a pane running `ssh` are copied to a temp
# folder on the remote host, and the remote paths typed. Keys and agents just work; for a
# host that wants a password, nex offers to turn on connection sharing in ~/.ssh/config so
# uploads reuse the pane's login. If an upload can't log in, the local paths are typed.
ssh-upload = true
# Splitting a pane that's running ssh, or opening a new tab from it, opens another session on
# the same host, in the same remote folder. With connection sharing on, it reuses the pane's
# login. The folder comes from the remote shell (OSC 7, or a "user@host: dir" title).
ssh-follow = true
# Agents on ssh hosts: nex installs its small helper, nex-host, in ~/.nex on hosts its panes
# connect to (no root needed; `rm -rf ~/.nex` removes it). Agents started with it keep
# running after their pane closes, show up in the Agents pane, and reopen when clicked.
ssh-agents = true
# With it, `claude` and `codex` typed in nex's ssh panes start through nex-host, so they keep
# running too: nex adds a few marked lines to the host's ~/.bashrc / ~/.zshrc (fish: a file
# in ~/.config/fish/conf.d). `ask`: an alert offers it once per host. `on`: every host,
# without asking. `off`: never. They only act in nex (ssh passes LC_TERMINAL=nex on, as
# Debian and Ubuntu set it up; elsewhere add `SendEnv LC_TERMINAL` to ~/.ssh/config), and
# `command claude` skips them. Remove them with `~/.nex/bin/nex-host shim remove`.
ssh-agent-shim = ask
# Share this machine's microphone with a pane's ssh host, as the host's default ALSA mic, so
# programs there (Claude Code's voice mode, arecord) can record from it. `manual`: the pane
# header's mic button or Ctrl+Shift+M (Cmd+Shift+M on macOS). `auto`: every ssh pane whose
# host nex can log in to without a password. `off`: no mic button. The local mic only
# records while a program on the host has the mic open, and the button turns red. Linux
# hosts with libasound2 only; nex adds a block to the host's ~/.asoundrc, removed when it stops.
ssh-mic = manual
scrollback-limit = 10000
# Bring back the last window at launch: its tabs, splits, each pane's folder and zoom, and the
# Files tab. Terminals start a fresh shell there and run again what was running in it (a dev
# server, ssh; Claude Code resumes its conversation). Only a plain `nex` restores; closing every tab starts the next launch fresh. Saved to
# $XDG_STATE_HOME/nex/session.json (~/.local/state/nex/session.json), or
# ~/Library/Application Support/nex/session.json on macOS.
restore-session = true

# command = fish
